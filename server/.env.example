# 邻里鲜生环境变量配置
# 复制此文件为 .env 并修改对应值

# JWT 密钥 (生产环境必须修改为随机长字符串)
JWT_SECRET=your-super-secret-jwt-key-change-this

# JWT 过期时间
JWT_EXPIRES_IN=7d

# 服务端口
PORT=3000

# 支付宝/微信支付配置 (生产环境需填入真实商户信息)
# ALIPAY_APP_ID=
# ALIPAY_PRIVATE_KEY=
# ALIPAY_PUBLIC_KEY=
# WXPAY_APP_ID=
# WXPAY_MCH_ID=
# WXPAY_API_KEY=
# WXPAY_NOTIFY_URL=
